# Others. — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB ─────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/others
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/others
MONGODB_URI=mongodb://localhost:27017/others

# ── Admin panel credentials ───────────────────────────────────────────────────
# REQUIRED — server will not start without these
ADMIN_USER=
ADMIN_PASS=

# ── PayFast payment gateway ───────────────────────────────────────────────────
# PAYFAST_SANDBOX=true  → sandbox mode (test only, no real money)
# PAYFAST_SANDBOX=false → live mode (MERCHANT_ID + MERCHANT_KEY required)
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Email Notifications (Optional) ────────────────────────────────────────────
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_EMAIL=
