# Others. — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB ─────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/others
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/others
MONGODB_URI=mongodb://localhost:27017/others

# ── Admin panel sign-in ───────────────────────────────────────────────────────
# REQUIRED — ADMIN_USER plus ONE of ADMIN_PASS_HASH (recommended) or ADMIN_PASS.
ADMIN_USER=
# Preferred: a scrypt hash, so the real password never sits in your host's env.
#   node scripts/hash-password.js "your long passphrase"   → paste the printed value
ADMIN_PASS_HASH=
# Fallback if no hash is set (use 12+ characters).
ADMIN_PASS=
# OPTIONAL but strongly recommended: two-factor sign-in with an authenticator app.
#   node scripts/totp-secret.js   → prints the secret + an otpauth:// link to scan
ADMIN_TOTP_SECRET=

# ── PayFast payment gateway ───────────────────────────────────────────────────
# PAYFAST_SANDBOX=true  → sandbox mode (test only, no real money) — reads the
#                          _SANDBOX credentials below.
# PAYFAST_SANDBOX=false → live mode — reads the _LIVE credentials below.
# Server refuses to start if the pair matching the active mode isn't set.
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID_SANDBOX=
PAYFAST_MERCHANT_KEY_SANDBOX=
PAYFAST_PASSPHRASE_SANDBOX=
PAYFAST_MERCHANT_ID_LIVE=
PAYFAST_MERCHANT_KEY_LIVE=
PAYFAST_PASSPHRASE_LIVE=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Cloudinary (Image & Video Storage) ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email Notifications (Optional) ────────────────────────────────────────────
# Sent via Resend's HTTPS API (not raw SMTP) — this is what actually works reliably
# from a hosted platform like Render, which can silently block/timeout outbound SMTP.
# Sign up free at resend.com and copy your API key.
RESEND_API_KEY=
# Must be onboarding@resend.dev (no setup required) or an address on a domain
# you've verified in Resend. Any other address will be rejected by the API.
SMTP_FROM=onboarding@resend.dev
ADMIN_EMAIL=
# Signs newsletter unsubscribe links so nobody can unsubscribe an address they don't
# control just by editing the query string. Optional — falls back to ADMIN_PASS,
# then a fixed default, but set your own random string in production.
UNSUBSCRIBE_SECRET=
